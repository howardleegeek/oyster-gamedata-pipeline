# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/

# Iron-law (Howard 2026-05-07): web portal source lives in <portal>/lib/
# and <portal>/app/api/downloads/. The Python build-dir ignores above
# accidentally swallowed those directories — un-ignore them here so the
# audit-fix changes show up in `git status` like every other source file.
!web-buyer/lib/
!web-buyer/lib/**
!web-tester/lib/
!web-tester/lib/**
!web-buyer/app/api/downloads/
!web-buyer/app/api/downloads/**
!web-tester/public/downloads/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Trajectories — runtime outputs, don't commit
trajectories/
runs/
*.jsonl
!tests/**/*.jsonl

# Secrets
.env
.env.*
!.env.example

# Mineflayer Node deps + Paper server jar — large binary blobs, not source
mineflayer/node_modules/
mineflayer/npm-debug.log*
bin/.cache/
*.jar

# Harness daemon logs (per-host, never commit)
harness.log
watchdog.log
nohup.out

# QA workdir — local output of bin/oyster-qa-tool.pyz, never commit
qa_workdir/

# Stray nested clones — block the "repo cloned inside repo" footgun.
# A nested copy here once caused harness_loop.py to read an old audit_gaps.yaml
# with 183 entries instead of the real 258, and dispatcher reported pending=0
# while disk had 58 pending P0/P1. Never again.
oyster-gamedata-pipeline/
oyster-agent-runner/
specs/auto/*
!specs/auto/.gitkeep

# Bundled-installer build artifacts (R05A/R05B). The fetch_*.py scripts
# rebuild these from pinned URLs in bin/build_bundled_installer/manifest.json
# at CI time, so checking them in would just rot. ~100MB+ of binary blobs.
bundle/

# Test outputs — generated at test runtime, never commit
tests/dashboard/
dashboard/merge_failures.log
dashboard/replay_attacks.json
tests/_payout_cron_test.log
active_session/
