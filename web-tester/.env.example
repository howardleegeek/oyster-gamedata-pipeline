# =====================================================================
# Oyster GameData — Tester Web Portal
# =====================================================================
# Copy this file to `.env.local` (Next picks it up automatically) and
# fill in real values.
#
# Howard 2026-05-07 IRON-LAW: when a service is not configured, the
# affected page renders <NotConfigured> (an amber panel listing the
# missing env vars) and the matching API route returns 503 with the
# same envVars list. There is NO sample-data fallback any more.
# =====================================================================

# ---------- Supabase (REQUIRED for /dashboard, /payouts, /download, /api/upload-tarball) ----------
# Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploaded tarballs (created via the migration)
SUPABASE_TARBALL_BUCKET=tarballs

# ---------- Auth providers ----------
# Configured inside the Supabase dashboard. These two are informational.
GITHUB_OAUTH_ENABLED=true
EMAIL_MAGICLINK_ENABLED=true

# ---------- App config ----------
# Public-facing URL of this Next deployment, used to build magic-link
# redirects, OAuth callbacks, and the .exe download URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Earnings model — keep these aligned with the rate cards shown in /docs.
# All values are in USD cents to avoid float math.
GAMEDATA_RATE_PER_HOUR_CENTS=600
GAMEDATA_MIN_PAYOUT_CENTS=2000

# Where the OysterRecorder.exe lives. Either:
#   - a public URL (e.g. GitHub Releases asset), OR
#   - a path inside this Next app's /public folder (e.g. /downloads/OysterRecorder.exe)
# When the file is missing, /api/download/[testerId] returns 404 with a
# remediation message — never a fabricated stub.
RECORDER_EXE_URL=/downloads/OysterRecorder.exe
RECORDER_VERSION=0.26.0

# ---------- Stripe Connect (REQUIRED for /payouts) ----------
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys
# Server-only — NEVER expose to the browser.
#
# When STRIPE_SECRET_KEY is unset OR not prefixed `sk_`, lib/stripe.ts
# THROWS on getStripeClient() and route handlers return 503 with
# envVars: ['STRIPE_SECRET_KEY']. The /payouts page renders <NotConfigured>.
STRIPE_SECRET_KEY=
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks
# (optional today — only needed when we add /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Connect platform application — get from https://dashboard.stripe.com/test/connect/applications
# Used for OAuth / Standard accounts; not strictly required for Express,
# but worth keeping populated so the integration is fully wired.
STRIPE_CONNECT_CLIENT_ID=

# ---------- Payout cron ----------
# Optional — Slack webhook URL for failure alerts. Leave blank to disable.
# Get one at https://api.slack.com/apps -> Incoming Webhooks.
PAYOUT_CRON_SLACK_WEBHOOK=
# Optional — log file path. Defaults to /tmp/payout_cron.log.
PAYOUT_CRON_LOG_PATH=/tmp/payout_cron.log
