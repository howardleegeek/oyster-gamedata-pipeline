# =====================================================================
# Oyster GameData — Tester Web Portal
# =====================================================================
# Copy this file to `.env.local` (Next picks it up automatically) and
# fill in real values. The app boots without these set — it falls back
# to "DEV MODE" with sample data, but auth and uploads will be no-ops.
# =====================================================================

# ---------- Supabase ----------
# Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploaded tarballs (created via the migration)
SUPABASE_TARBALL_BUCKET=tarballs

# ---------- Auth providers ----------
# Configured inside the Supabase dashboard. These two are informational.
GITHUB_OAUTH_ENABLED=true
EMAIL_MAGICLINK_ENABLED=true

# ---------- App config ----------
# Public-facing URL of this Next deployment, used to build magic-link
# redirects, OAuth callbacks, and the .exe download URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Earnings model — keep these aligned with the rate cards shown in /docs.
# All values are in USD cents to avoid float math.
GAMEDATA_RATE_PER_HOUR_CENTS=600
GAMEDATA_MIN_PAYOUT_CENTS=2000

# Where the OysterRecorder.exe lives. Either:
#   - a public URL (e.g. GitHub Releases asset), OR
#   - a path inside this Next app's /public folder (e.g. /downloads/OysterRecorder.exe)
RECORDER_EXE_URL=/downloads/OysterRecorder.exe
RECORDER_VERSION=0.1.0

# ---------- Dev fallback ----------
# When true (and no Supabase URL is set), the dashboard / payouts pages
# render with sample data behind a "[DEV MODE]" banner.
NEXT_PUBLIC_DEV_FALLBACK=true

# ---------- Stripe Connect (FUTURE — wire when payouts go live) ----------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_CONNECT_CLIENT_ID=ca_xxx
