# =====================================================================
# Oyster GameData — Buyer Web Portal
# =====================================================================
# Copy this file to `.env.local` (Next picks it up automatically) and
# fill in real values.
#
# Howard 2026-05-07 IRON-LAW: when a service is not configured, the
# affected page renders <NotConfigured> (an amber panel listing the
# missing env vars) and the matching API route returns 503 with the
# same envVars list. There is NO sample-catalog or fake-checkout
# fallback any more.
# =====================================================================

# ---------- Supabase (REQUIRED for /browse, /cart, /checkout, /downloads, /tarball/[id]) ----------
# Project URL, e.g. https://abcd1234.supabase.co
# Production: use a SEPARATE Supabase project from the tester portal.
# Dev / prototyping: point at the SAME project as web-tester so the
# `tarballs` table is shared (the buyer schema only ADDS new tables).
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket where the tester portal wrote tarballs (read-only here).
SUPABASE_TARBALL_BUCKET=tarballs

# ---------- Auth providers ----------
# Configured inside the Supabase dashboard. These two are informational.
GITHUB_OAUTH_ENABLED=true
EMAIL_MAGICLINK_ENABLED=true

# ---------- App config ----------
# Public-facing URL of this Next deployment, used for magic-link redirects,
# OAuth callbacks, and Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Pricing knobs — keep aligned with /licenses page copy.
GAMEDATA_PRICE_PER_GB_CENTS=2500    # $25.00 / GB list price
GAMEDATA_RESEARCH_DISCOUNT_PCT=40   # 40% off for academic/research

# Signed-URL TTL for /downloads links. 24h (= 86400s) per spec.
DOWNLOAD_LINK_TTL_SECONDS=86400

# ---------- Stripe Checkout (REQUIRED for /checkout and /api/checkout) ----------
# Get keys at https://dashboard.stripe.com/apikeys
# Test keys (sk_test_*, pk_test_*) are fine for dev. Webhook secret comes
# from the Stripe CLI: `stripe listen --forward-to http://localhost:3001/api/checkout/webhook`
#
# When BOTH STRIPE_SECRET_KEY and STRIPE_PUBLISHABLE_KEY are unset,
# lib/stripe.ts:getStripe() THROWS and /api/checkout returns 503 with
# envVars: ['STRIPE_SECRET_KEY', 'STRIPE_PUBLISHABLE_KEY']. The /checkout
# page renders <NotConfigured>.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe redirects buyers after Checkout. Both are this app's URLs.
STRIPE_CHECKOUT_SUCCESS_PATH=/downloads?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_PATH=/cart
